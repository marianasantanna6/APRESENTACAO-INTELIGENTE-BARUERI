{
  "compilerOptions": {
    "rootDir": "./src",

    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "target": "ES2023",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "sourceMap": true,
    "declaration": true,
    "removeComments": true,

    "outDir": "./dist",
    "incremental": false,

    "skipLibCheck": true,
    "strict": true,

    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "prisma.config.ts",
    "prisma/seed.ts"
  ]
}