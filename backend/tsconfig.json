{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2023",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "sourceMap": true,
    "declaration": true,
    "removeComments": true,

    "outDir": "./dist",
    "incremental": true,

    "skipLibCheck": true,
    "strict": true,

    "forceConsistentCasingInFileNames": true
  }
}